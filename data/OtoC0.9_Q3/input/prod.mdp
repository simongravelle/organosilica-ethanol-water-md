integrator = md
nsteps = 50000000
dt = 0.001
comm_mode = none
comm_grps = system
gen-vel = no
gen-temp = 300

cutoff-scheme = Verlet
nstlist = 10
ns_type = grid

nstlog = 10000
nstenergy = 10000
nstxout-compressed = 2500

vdw-type = Cut-off
rvdw = 1.4

coulombtype = pme
fourierspacing = 0.1
pme-order = 4
rcoulomb = 1.4

constraint-algorithm = lincs
constraints = hbonds
continuation = yes

tcoupl = v-rescale
ld-seed = 48456
tc-grps = Sol Sil Eth
tau-t = 0.1 0.1 0.1
ref-t = 300 300 300
nhchainlength = 1
