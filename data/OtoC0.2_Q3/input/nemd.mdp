integrator = md
nsteps = 50000000
dt = 0.001
comm_mode = linear
comm_grps = system
gen-vel = no
gen-temp = 300

cutoff-scheme = Verlet
nstlist = 10
ns_type = grid

nstlog = 10000
nstenergy = 10000
nstxout = 2500
nstvout = 2500
nstfout = 0

vdw-type = Cut-off
rvdw = 1.4

coulombtype = pme
fourierspacing = 0.1
pme-order = 4
rcoulomb = 1.4

constraint-algorithm = lincs
constraints = hbonds
continuation = yes

tcoupl = v-rescale
ld-seed = 48456
tc-grps = Sol Sil Eth
tau-t = 0.1 0.1 0.1
ref-t = 300 300 300
nhchainlength = 1

pull = yes
pull-coord1-type = constraint
pull-coord1-geometry = direction-periodic
pull-coord1-dim = Y N N
pull-coord1-vec = 1 0 0
pull-coord1-start = yes
pull-ngroups = 2
pull-group1-name = Sil1
pull-group1-pbcatom = 1
pull-group2-name   = Sil2
pull-group2-pbcatom = 14158
pull-coord1-groups = 1 2
pull-coord1-rate = 0.01
pull-coord1-k = 5000 ; kJ mol^-1 nm^-2
pull-pbc-ref-prev-step-com = yes
